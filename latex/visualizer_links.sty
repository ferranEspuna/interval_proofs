\definecolor{VisualizerLinkColor}{RGB}{0,82,155}
\newcommand{\DeclareVisualizerLink}[2]{%
  \expandafter\def\csname intervalproofs@visualizer@#1\endcsname{#2}%
}
\DeclareRobustCommand{\Visualizer}[2]{%
  \begingroup
  \ifcsname intervalproofs@visualizer@#1\endcsname
    \edef\VisualizerTarget{\csname intervalproofs@visualizer@#1\endcsname}%
    \href{\VisualizerTarget}{{\color{VisualizerLinkColor}#2}}%
  \else
    \PackageError{visualizer_links}{Unknown visualizer construction `#1'}%
      {Regenerate visualizer_links.sty from construction_visualizer_links.py.}%
    #2%
  \fi
  \endgroup
}

